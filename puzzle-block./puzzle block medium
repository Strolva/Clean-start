<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio Waveform Jigsaw Module</title>
    <style>
        body { 
            background: #0f172a; color: #38bdf8; font-family: sans-serif; 
            display: flex; flex-direction: column; align-items: center; justify-content: flex-start; 
            min-height: 100vh; margin: 0; padding: 20px 10px; overflow-x: hidden;
            -webkit-user-select: none; user-select: none;
        }

        #top-bar {
            width: 100%; max-width: 400px; display: flex; justify-content: space-between; 
            align-items: center; margin-bottom: 20px;
        }
        #homeBtn { background: #334155; color: #fff; padding: 10px 15px; font-size: 0.9rem; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;}
        
        #grid-controls { display: flex; align-items: center; gap: 10px; background: #1e293b; padding: 5px; border-radius: 8px;}
        .stepper-btn { background: #334155; color: white; border: none; border-radius: 6px; padding: 8px 12px; font-size: 1rem; cursor: pointer; touch-action: manipulation; }
        .stepper-btn:active { background: #475569; }
        #grid-size-label { font-weight: bold; width: 40px; text-align: center; color: #fff; }

        #controls { margin-bottom: 20px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 420px;}
        .btn { 
            padding: 10px 14px; border-radius: 8px; border: none; font-size: 0.85rem;
            font-weight: bold; cursor: pointer; transition: 0.2s; 
            display: flex; align-items: center; justify-content: center;
        }
        
        .btn-audio { background: #38bdf8; color: #0f172a; }
        .btn-record { background: #f59e0b; color: #0f172a; }
        .btn-record.recording { background: #ef4444; color: #fff; animation: pulseRecord 1s infinite; }
        .btn-shuffle { background: #a855f7; color: #fff; display: none; }
        
        #refBtn { background: #22c55e; color: #fff; display: none; }
        #stopBtn { background: #ef4444; color: #fff; display: none; }

        @keyframes pulseRecord {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        #grid-container { 
            position: relative; padding: 10px; background: #1e293b; 
            border-radius: 12px; transition: all 0.5s ease;
            width: 100%; max-width: 400px; box-sizing: border-box;
        }
        #ghost-wave { 
            position: absolute; top: 10px; left: 10px; right: 10px; bottom: 10px;
            width: calc(100% - 20px); height: calc(100% - 20px); opacity: 0.2; pointer-events: none; 
        }
        #grid { 
            display: grid; 
            grid-template-columns: repeat(var(--cols, 3), 1fr); 
            gap: 6px; width: 100%; position: relative; 
        }
        .piece { 
            background: rgba(30, 41, 59, 0.9); cursor: grab; border-radius: 6px; 
            border: 2px solid #475569; overflow: hidden; aspect-ratio: 1 / 1;
            display: flex; align-items: center; justify-content: center;
            position: relative; touch-action: none; transition: border-color 0.2s, transform 0.1s;
        }
        .piece:active { cursor: grabbing; transform: scale(0.96); }
        .piece.correct { border-color: #0ea5e9; }
        .piece.dragging { opacity: 0.5; border-style: dashed; }
        
        canvas { width: 100%; height: 100%; pointer-events: none; display: block; }
        #status { margin-top: 20px; font-weight: bold; min-height: 20px; text-align: center; font-size: 0.9rem;}

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0px #38bdf8; }
            50% { transform: scale(1.02); box-shadow: 0 0 25px #38bdf8; }
            100% { transform: scale(1); box-shadow: 0 0 0px #38bdf8; }
        }
        .victory { animation: pulse 2s infinite ease-in-out; border: 2px solid #22c55e; }
    </style>
</head>
<body>

    <div id="top-bar">
        <button id="homeBtn" onclick="window.location.href='/Clean-start/index.html'">◀ Home</button>
        <div id="grid-controls">
            <button class="stepper-btn" onclick="changeGridSize(-1)">➖</button>
            <span id="grid-size-label">3x3</span>
            <button class="stepper-btn" onclick="changeGridSize(1)">➕</button>
        </div>
    </div>

    <div id="controls">
        <label class="btn btn-audio">
            📂 LOAD AUDIO
            <input type="file" id="audioUpload" accept="audio/*" style="display: none;">
        </label>
        
        <button id="recordBtn" class="btn btn-record">🎤 RECORD</button>
        <button id="shuffleBtn" class="btn btn-shuffle" onclick="manualShuffle()">🧩 SHUFFLE</button>
        
        <button id="refBtn" class="btn" onclick="playReference()">REF AUDIO</button>
        <button id="stopBtn" class="btn" onclick="stopEverything()">STOP</button>
    </div>

    <div id="grid-container">
        <canvas id="ghost-wave"></canvas>
        <div id="grid" style="--cols: 3;"></div>
    </div>

    <p id="status">Upload or record audio to build your waveform puzzle!</p>

    <script>
        let audioCtx, mainBuffer;
        let activeSources = []; 
        
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;
        
        let gridSize = 3; 
        let totalPieces = gridSize * gridSize;
        let pieces = [];
        let draggedIdx = null; 
        let waveformImageSrc = null;

        function scramblePieces() {
            do {
                pieces = Array.from({length: totalPieces}, (_, i) => i).sort(() => Math.random() - 0.5);
            } while (pieces.every((p, i) => p === i) && totalPieces > 1);
        }
        scramblePieces(); 

        function manualShuffle() {
            if (!mainBuffer) return;
            stopEverything();
            scramblePieces();
            document.getElementById('grid-container').classList.remove('victory');
            document.getElementById('status').innerText = "Matrix randomized! Match the frequencies.";
            render();
            // Optional flavor: play the first item of the new scramble sequence
            playSlice(pieces[0]);
        }

        function changeGridSize(dir) {
            let newSize = gridSize + dir;
            if (newSize >= 3 && newSize <= 5) {
                gridSize = newSize;
                totalPieces = gridSize * gridSize;
                
                document.getElementById('grid-size-label').innerText = `${gridSize}x${gridSize}`;
                document.getElementById('grid').style.setProperty('--cols', gridSize);
                
                scramblePieces();
                stopEverything();
                document.getElementById('grid-container').classList.remove('victory');
                
                if (mainBuffer) {
                    document.getElementById('status').innerText = `Matrix updated to ${gridSize}x${gridSize}!`;
                    generateWaveformGridImage();
                }
                render();
            }
        }

        function initAudioCtx() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        async function processAudioData(arrayBuffer) {
            const status = document.getElementById('status');
            status.innerText = "Decoding Audio Framework...";
            try {
                mainBuffer = await audioCtx.decodeAudioData(arrayBuffer);
                
                document.getElementById('refBtn').style.display = 'inline-block';
                document.getElementById('stopBtn').style.display = 'inline-block';
                document.getElementById('shuffleBtn').style.display = 'inline-block';
                
                status.innerText = "Audio parsed. Reconstruct the sequential waveform!";
                
                scramblePieces();
                document.getElementById('grid-container').classList.remove('victory');
                
                generateWaveformGridImage();
                render();
            } catch (e) {
                status.innerText = "❌ Error reading audio file!";
                console.error(e);
            }
        }

        // --- HANDLERS FOR FILE UPLOADS ---
        document.getElementById('audioUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            initAudioCtx();
            const reader = new FileReader();
            reader.onload = async function(ev) { await processAudioData(ev.target.result); };
            reader.readAsArrayBuffer(file);
        });

        document.getElementById('recordBtn').addEventListener('click', async () => {
            const recordBtn = document.getElementById('recordBtn');
            const status = document.getElementById('status');

            if (!isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];
                    mediaRecorder.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };
                    mediaRecorder.onstop = async () => {
                        initAudioCtx();
                        const audioBlob = new Blob(audioChunks);
                        const arrayBuffer = await audioBlob.arrayBuffer();
                        await processAudioData(arrayBuffer);
                    };
                    mediaRecorder.start();
                    isRecording = true;
                    recordBtn.innerText = "🛑 STOP";
                    recordBtn.classList.add('recording');
                    status.innerText = "🔴 Capturing mic feed...";
                } catch (err) {
                    status.innerText = "❌ Mic feed dropped.";
                    console.error(err);
                }
            } else {
                mediaRecorder.stop();
                isRecording = false;
                recordBtn.innerText = "🎤 RECORD";
                recordBtn.classList.remove('recording');
            }
        });

        function stopEverything() {
            activeSources.forEach(s => { try { s.stop(); } catch(e) {} });
            activeSources = [];
        }

        function playSlice(idx) {
            if (!mainBuffer) return;
            stopEverything(); 
            const source = audioCtx.createBufferSource();
            const gainNode = audioCtx.createGain();
            source.buffer = mainBuffer;
            
            const sliceWidth = mainBuffer.duration / totalPieces;
            const startOffset = idx * sliceWidth;
            const playDuration = sliceWidth;

            source.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            gainNode.gain.setValueAtTime(0.001, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(1, audioCtx.currentTime + 0.01);
            gainNode.gain.setValueAtTime(1, audioCtx.currentTime + playDuration - 0.01);
            gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + playDuration);
            
            source.start(0, startOffset, playDuration);
            activeSources.push(source);
        }

        function playReference() {
            if (!mainBuffer) return;
            stopEverything();
            const source = audioCtx.createBufferSource();
            source.buffer = mainBuffer;
            source.connect(audioCtx.destination);
            source.start(0);
            activeSources.push(source);
        }

        function extractWaveformData(buffer, pointsNeeded) {
            if (!buffer) return new Float32Array(pointsNeeded).fill(0);
            const rawData = buffer.getChannelData(0);
            const step = Math.floor(rawData.length / pointsNeeded);
            const peaks = new Float32Array(pointsNeeded);
            for (let i = 0; i < pointsNeeded; i++) {
                let max = 0; let start = i * step;
                for (let j = 0; j < step; j++) {
                    let val = Math.abs(rawData[start + j] || 0);
                    if (val > max) max = val;
                }
                peaks[i] = max;
            }
            return peaks;
        }

        function generateWaveformGridImage() {
            if (!mainBuffer) return;
            
            const canvas = document.createElement('canvas');
            const size = 600; 
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');
            
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(0, 0, size, size);

            const cellSize = size / gridSize;
            const totalPoints = size * gridSize; 
            const peaks = extractWaveformData(mainBuffer, totalPoints);
            
            ctx.strokeStyle = '#a855f7'; 
            ctx.lineWidth = 2.5;
            ctx.shadowBlur = 4;
            ctx.shadowColor = '#a855f7';
            
            for (let row = 0; row < gridSize; row++) {
                for (let col = 0; col < gridSize; col++) {
                    const cellIndex = (row * gridSize) + col;
                    const startX = col * cellSize;
                    const centerY = (row * cellSize) + (cellSize / 2);
                    
                    ctx.beginPath();
                    const segmentPoints = size / gridSize;
                    const segmentStartPeakIdx = cellIndex * segmentPoints;

                    for (let localX = 0; localX < cellSize; localX++) {
                        const globalX = startX + localX;
                        const peakIdx = Math.floor(segmentStartPeakIdx + ((localX / cellSize) * segmentPoints));
                        const amp = (peaks[peakIdx] || 0) * (cellSize / 2.3); 
                        
                        if (localX === 0) ctx.moveTo(globalX, centerY);
                        ctx.lineTo(globalX, centerY - amp);
                        ctx.lineTo(globalX, centerY + amp);
                    }
                    ctx.stroke();
                }
            }
            
            waveformImageSrc = canvas.toDataURL();

            const ghostCanvas = document.getElementById('ghost-wave');
            ghostCanvas.width = size; ghostCanvas.height = size;
            const gCtx = ghostCanvas.getContext('2d');
            gCtx.drawImage(canvas, 0, 0);
        }

        function render() {
            const grid = document.getElementById('grid');
            const container = document.getElementById('grid-container');
            grid.innerHTML = '';
            const isSolved = pieces.every((p, i) => p === i);

            pieces.forEach((pIdx, i) => {
                const div = document.createElement('div');
                div.className = `piece ${pIdx === i ? 'correct' : ''}`;
                div.setAttribute('data-index', i);
                
                const origCol = pIdx % gridSize;
                const origRow = Math.floor(pIdx / gridSize);
                
                if (waveformImageSrc) {
                    div.style.backgroundImage = `url(${waveformImageSrc})`;
                    div.style.backgroundSize = `${gridSize * 100}% ${gridSize * 100}%`;
                    div.style.backgroundPosition = `${(origCol / (gridSize - 1)) * 100}% ${(origRow / (gridSize - 1)) * 100}%`;
                }

                // --- DRAG CONTROLS ---
                div.draggable = true;
                div.ondragstart = (e) => { draggedIdx = i; div.classList.add('dragging'); e.dataTransfer.setData('text/plain', i); };
                div.ondragend = () => div.classList.remove('dragging');
                div.ondragover = (e) => e.preventDefault();
                div.ondrop = (e) => { e.preventDefault(); const from = draggedIdx !== null ? draggedIdx : e.dataTransfer.getData('text'); executeSwap(parseInt(from), i); };

                // --- MOBILE TOUCH HANDLING CONTROLS ---
                div.addEventListener('touchstart', (e) => { if(e.touches.length === 1) draggedIdx = i; }, {passive: true});
                div.addEventListener('touchend', (e) => {
                    const changedTouch = e.changedTouches[0];
                    const targetEl = document.elementFromPoint(changedTouch.clientX, changedTouch.clientY);
                    const dropZone = targetEl ? targetEl.closest('.piece') : null;
                    if (dropZone) {
                        const toIndex = parseInt(dropZone.getAttribute('data-index'));
                        if (draggedIdx !== null && draggedIdx !== toIndex) executeSwap(draggedIdx, toIndex);
                        else playSlice(pIdx);
                    } else {
                        playSlice(pIdx);
                    }
                    draggedIdx = null;
                });

                div.onclick = (e) => { if(e.pointerType === 'mouse' || e.type === 'click') playSlice(pIdx); };
                grid.appendChild(div);
            });

            function executeSwap(from, to) {
                if (isNaN(from) || isNaN(to)) return;
                [pieces[from], pieces[to]] = [pieces[to], pieces[from]];
                playSlice(pieces[to]);
                render();
            }

            if (isSolved && mainBuffer) { 
                document.getElementById('status').innerText = "🎉 WAVEFORM DECODED SUCCESSFULLY!";
                container.classList.add('victory');
                playReference();
            }
        }
        
        render();
    </script>
</body>
</html>
